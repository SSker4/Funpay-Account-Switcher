{
  "manifest_version": 3,
  "name": "FunPay Account Switcher",
  "description": "Быстрое переключение сохраненных аккаунтов FunPay с ожиданием Cloudflare Turnstile.",
  "version": "1.0.0",
  "permissions": ["storage", "tabs", "cookies"],
  "host_permissions": ["https://funpay.com/*", "https://*.funpay.com/*"],
  "action": {
    "default_title": "FunPay Accounts",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://funpay.com/account/login*", "https://www.funpay.com/account/login*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
